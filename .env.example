# Copy to .env for local dev. Never commit the real .env.
#
# Ports below (5433, 19000) assume a native Postgres already owns 5432 on the
# host, which is why docker-compose.yml's default 5432/9000 host bindings get
# remapped locally. If your host has 5432/9000 free, use those instead — just
# keep this file and docker-compose.yml's actual running ports in agreement.
POSTGRES_PASSWORD=devonly
TOPOS_DB_DSN=postgresql://topos:devonly@localhost:5433/topos

S3_ACCESS_KEY=topos
S3_SECRET_KEY=devonlydevonly
TOPOS_S3_ENDPOINT=http://localhost:19000
TOPOS_S3_BUCKET=topos-artifacts

# ── Extraction LLM ───────────────────────────────────────────────────────────
# REQUIRED for real extraction. Without a genuine key the worker falls back to a
# mock client that FABRICATES claims — `topos-cli health` reports llm_mode:mock.
# https://openrouter.ai/keys
TOPOS_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
TOPOS_LLM_BASE_URL=https://openrouter.ai/api/v1
TOPOS_LLM_MODEL=mistralai/mistral-large-2512
TOPOS_LLM_MONTHLY_BUDGET_EUR=250

# ── Discovery: Sonar (source `sonar_web`) ────────────────────────────────────
# Perplexity direct is tried first, OpenRouter is the fallback. Direct is worth
# having: it returns structured citations that OpenRouter strips.
# https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# ── Discovery: xAI web search + X search (source `social`) ───────────────────
# Grok models go to xAI first and fall back to OpenRouter.
# https://console.x.ai
XAI_API_KEY=
TOPOS_XAI_MODEL=grok-4.5

# ── Search reranking (ADR-013) ────────────────────────────────────────────────
# No separate key — reuses OPENROUTER_API_KEY above. Set TOPOS_RERANK_ENABLED=
# false for pure lexical (ts_rank) ordering with zero external calls.
TOPOS_RERANK_ENABLED=true
TOPOS_RERANK_MODELS=voyageai/rerank-2.5-lite,nvidia/llama-nemotron-rerank-vl-1b-v2:free
TOPOS_RERANK_CANDIDATES=50

# ── Discovery: web search engines (source `websearch`) ───────────────────────
# All optional. `engine=auto` queries every engine that has credentials, so set
# as many or as few as you want. SearXNG is self-hosted and needs no key.
TOPOS_BRAVE_API_KEY=          # https://brave.com/search/api/
TOPOS_GOOGLE_CSE_API_KEY=     # https://developers.google.com/custom-search/v1/introduction
TOPOS_GOOGLE_CSE_CX=          # the Programmable Search engine id
TOPOS_BING_API_KEY=           # https://portal.azure.com  (Bing Search v7)
TOPOS_TAVILY_API_KEY=         # https://app.tavily.com
TOPOS_SERPER_API_KEY=         # https://serper.dev
TOPOS_SEARXNG_BASE_URL=       # e.g. http://localhost:8080

TOPOS_OIDC_DISCOVERY_URL=
TOPOS_OIDC_CLIENT_ID=
TOPOS_OIDC_CLIENT_SECRET=
TOPOS_LOG_LEVEL=INFO
